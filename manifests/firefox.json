{
  "manifest_version": 2,
  "name": "CoCo Translate",
  "description": "Hover Translation",
  "homepage_url": "https://hypnotic-denim-05e.notion.site/CoCo-Translate-175cbce1913780ca8efbf2267976a0a7",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "tabs",
    "<all_urls>"
  ],
  "web_accessible_resources": [
    "icons/*.png",
    "icons/loading.gif",
    "popup.css"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "translationCache.js",
      "markup.js",
      "sitePatterns.js",
      "glossary.js",
      "dictionary.js",
      "postprocess.js",
      "rateLimiter.js",
      "translator.js",
      "llm.js",
      "translationService.js",
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://challenges.cloudflare.com/*",
        "*://*.hcaptcha.com/*",
        "*://*.recaptcha.net/*",
        "*://www.google.com/recaptcha/*"
      ],
      "js": [
        "markup.js",
        "sitePatterns.js",
        "captions.js",
        "content.js",
        "youtube.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "browser_action": {
    "default_icon": "icons/icon-48.png",
    "default_title": "CoCo Translate",
    "default_popup": "popup.html"
  },
  "icons": {
    "64": "icons/icon-48.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{38e29c13-baf5-47b1-a26f-a53a3aedcc3c}",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    }
  },
  "commands": {
    "toggle-page-translation": {
      "suggested_key": {
        "default": "Alt+Shift+Y",
        "mac": "MacCtrl+Shift+Y"
      },
      "description": "Translate / restore this page"
    },
    "toggle-display-mode": {
      "description": "Switch page translation between replace and bilingual"
    }
  }
}
